# Endereço do Postgres. No EasyPanel, use o "Internal Connection URL" do serviço Postgres do projeto.
DATABASE_URL=postgres://central:SENHA@central-db:5432/central

# Código para criar o PRIMEIRO acesso (o do Wigor) em /primeiro-acesso.
# Gere um valor longo e aleatório. Depois que o primeiro acesso existir, a página se fecha sozinha.
SETUP_TOKEN=

# Endereço público, sem barra no fim. Usado para montar links de convite.
APP_URL=https://central.marifrancafotografia.com.br

TZ=America/Sao_Paulo
